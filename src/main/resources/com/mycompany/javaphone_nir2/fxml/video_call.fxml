<?xml version="1.0" encoding="UTF-8"?>

<!-- 
    ОКНО ВИДЕОЗВОНКА (Video Call Window)
    Макет включает:
    - Верхняя панель с кнопками и названием звонка
    - Основная область: два видеоокна (своё и собеседника)
    - Нижняя панель с кнопками управления (микрофон, фильтр, камера)
    - Справа: список сообщений в ходе звонка
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="510.0" prefWidth="824.0" style="-fx-font-family: 'Segoe UI';" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.javaphone_nir2.controllers.VideoCallController">

    <top>
        <HBox prefHeight="60.0" prefWidth="694.0" spacing="10" style="-fx-padding: 10; -fx-background-color: #1a225d;">
         <HBox prefHeight="40.0" spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
               <Button fx:id="endCallButton" prefHeight="40" prefWidth="110.0" style="-fx-font-size: 16; -fx-border-color: #ffffff; -fx-border-width: 2; -fx-background-color: transparent; -fx-text-fill: white;" text="Выход" HBox.hgrow="NEVER" />
               <Button fx:id="settingsButton" prefHeight="40" prefWidth="110.0" style="-fx-font-size: 16; -fx-border-color: #ffffff; -fx-border-width: 2; -fx-background-color: transparent; -fx-text-fill: white;" text="Настройки" HBox.hgrow="NEVER" />
               <Label fx:id="callStatusLabel" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="40.0" prefWidth="450.0" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-border-width: 2; -fx-border-color: white;" text="Чат с AVKuzma " HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets left="10.0" right="10.0" />
                  </padding>
               </Label>
            </children>
         </HBox>
        </HBox>
    </top>

    <center>
        <HBox spacing="0">

            <VBox spacing="0" HBox.hgrow="ALWAYS">

                <StackPane fx:id="remoteVideoContainer" prefHeight="405.0" prefWidth="392.0" style="-fx-background-color: #1a1a1a;" VBox.vgrow="ALWAYS">
                    <Label style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="камера 1" />
                    
                    <StackPane fx:id="localVideoContainer" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="120.0" prefWidth="180.0" style="-fx-background-color: #ecf0f1; -fx-border-color: #2c3e50; -fx-border-width: 2;" StackPane.alignment="BOTTOM_LEFT">
                        <Label style="-fx-text-fill: #333; -fx-font-size: 12;" text="камера 2" />
                    </StackPane>
                </StackPane>
                
                <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #454f97;">
                    
                    <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #454f97;" HBox.hgrow="ALWAYS">
                        
                        <Button fx:id="micButton" prefHeight="40.0" prefWidth="100.0" style="-fx-font-size: 14; -fx-padding: 5;" text="Микрофон" HBox.hgrow="NEVER" />
                        
                        <Button fx:id="filterButton" prefHeight="40.0" prefWidth="100.0" style="-fx-font-size: 14; -fx-padding: 5;" text="Фильтр" HBox.hgrow="NEVER" />
                        
                        <Button fx:id="cameraButton" prefHeight="40.0" prefWidth="100.0" style="-fx-font-size: 14; -fx-padding: 5;" text="Камера" HBox.hgrow="NEVER" />
                  <TextArea fx:id="recognizedTextArea" editable="false" prefHeight="100.0" prefWidth="257.0" style="-fx-control-inner-background: #dadef7; -fx-font-size: 14;" text="Распознанный текст" wrapText="true" HBox.hgrow="ALWAYS" />
                    </HBox>
                </HBox>
            </VBox>
        </HBox>
    </center>
   <right>
         
         <VBox fx:id="chatContainer" prefHeight="450.0" prefWidth="286.0" BorderPane.alignment="CENTER">
         <TextArea fx:id="callChatHistory" editable="false" prefHeight="406.0" prefWidth="286.0" style="-fx-control-inner-background: #dadef7; -fx-font-size: 12;" wrapText="true" VBox.vgrow="ALWAYS" />
         <HBox prefHeight="0.0" prefWidth="478.0" spacing="5" style="-fx-padding: 10; -fx-background-color: #dadef7;">
            <children>
               <TextField fx:id="callMessageInput" promptText="Введите сообщение..." style="-fx-padding: 8; -fx-font-size: 12;" HBox.hgrow="ALWAYS" />
               <Button fx:id="sendCallMessageButton" prefWidth="100" style="-fx-padding: 8; -fx-font-size: 12;" text="Отправить" HBox.hgrow="ALWAYS" />
            </children>
         </HBox>
         </VBox>
   </right>
</BorderPane>
