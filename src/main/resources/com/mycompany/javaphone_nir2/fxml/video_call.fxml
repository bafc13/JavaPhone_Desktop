<?xml version="1.0" encoding="UTF-8"?>

<!-- 
    ОКНО ВИДЕОЗВОНКА (Video Call Window)
    Макет включает:
    - Верхняя панель с кнопками и названием звонка
    - Основная область: два видеоокна (своё и собеседника)
    - Нижняя панель с кнопками управления (микрофон, фильтр, камера)
    - Справа: список сообщений в ходе звонка
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootContainer" prefHeight="510.0" prefWidth="824.0" style="-fx-font-family: 'Segoe UI';" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.javaphone_nir2.controllers.VideoCallController">

    <top>
        <HBox fx:id="headerContainer" prefHeight="60.0" prefWidth="694.0" spacing="10">
         <HBox prefHeight="40.0" spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
               <Button fx:id="endCallButton" prefHeight="40" prefWidth="110.0" text="Выход" HBox.hgrow="NEVER" />
               <Button fx:id="gameButton" prefHeight="40" prefWidth="110.0" text="Играть" HBox.hgrow="NEVER" />
               <Label fx:id="callStatusLabel" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="40.0" prefWidth="450.0" text="Чат с AVKuzma " HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets left="10.0" right="10.0" />
                  </padding>
               </Label>
            </children>
         </HBox>
        </HBox>
    </top>

    <center>
        <SplitPane fx:id="videoSplitPane" dividerPositions="0.75" orientation="HORIZONTAL">
            <VBox minWidth="550" spacing="0" HBox.hgrow="ALWAYS">
                <StackPane fx:id="videoContainer" VBox.vgrow="ALWAYS">

                          <StackPane fx:id="localVideoContainer" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="154.0" prefWidth="224.0" style="-fx-background-color: #ecf0f1; -fx-border-color: #2c3e50; -fx-border-width: 2;" StackPane.alignment="BOTTOM_LEFT">
                        <com.mycompany.javaphone_nir2.WebRtcVideoPanel fx:id="localVideo" />
                        <Label fx:id="localVideoLabel" text="Камера 2" StackPane.alignment="TOP_LEFT" />
                    </StackPane>
                    <StackPane fx:id="remoteVideoContainer" StackPane.alignment="BOTTOM_RIGHT">
                        <com.mycompany.javaphone_nir2.WebRtcVideoPanel fx:id="remoteVideo" />
                        <Label fx:id="remoteVideoLabel" text="Камера 1" StackPane.alignment="TOP_LEFT" />
                    </StackPane>
                </StackPane>
                
                <HBox fx:id="footerContainer" spacing="10">
                    
                    <HBox fx:id="callControlContainer" alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS">
                        
                        <Button fx:id="micButton" prefHeight="40.0" prefWidth="100.0" text="Микрофон" HBox.hgrow="NEVER" />
                        
                        <Button fx:id="filterButton" prefHeight="40.0" prefWidth="100.0" text="Фильтр" HBox.hgrow="NEVER" />
                        
                        <Button fx:id="cameraButton" prefHeight="40.0" prefWidth="100.0" text="Камера" HBox.hgrow="NEVER" />
                    </HBox>
                </HBox>
            </VBox>
            
                        <VBox fx:id="chatContainer" minWidth="285" prefHeight="450.0" prefWidth="286.0">
                <children>
                    <ListView fx:id="callChatHistory" editable="false" minWidth="100" prefHeight="406.0" prefWidth="286.0" VBox.vgrow="ALWAYS">
                 </ListView>
                   <HBox fx:id="messageContainer" alignment="BOTTOM_CENTER" prefHeight="0.0" prefWidth="478.0" spacing="5">
                      <children>
                          <VBox HBox.hgrow="ALWAYS">
                              <children>
                                  <Label fx:id="typingIndicator" managed="false" visible="false">
                              <padding>
                                 <Insets left="10.0" />
                              </padding></Label>
                                  <TextField fx:id="callMessageInput" promptText="Введите сообщение..." />
                              </children>
                          </VBox>
                         <Button fx:id="sendCallMessageButton" prefWidth="100" text="Отправить" HBox.hgrow="ALWAYS" />
                      </children>
                   </HBox>
            </children>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
