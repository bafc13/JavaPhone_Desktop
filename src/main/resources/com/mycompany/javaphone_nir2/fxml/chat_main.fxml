<?xml version="1.0" encoding="UTF-8"?>

<!-- 
    ГЛАВНОЕ ОКНО ЧАТА (Общее окно)
    Макет включает:
    - Верхняя панель с кнопками (Exit, Settings, Chat with AVKuzma, Call button)
    - Левая панель с контактами (AVKuzma, Кто-то)
    - Центральная часть с историей сообщений
    - Нижняя часть с полем ввода текста
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" style="-fx-font-family: 'Segoe UI';" xmlns="http://javafx.com/javafx/25" fx:controller="com.mycompany.javaphone_nir2.controllers.ChatController">
    <top>
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #1a225d;" HBox.hgrow="ALWAYS">
            <children>
                <HBox prefHeight="40.0" spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Button fx:id="exitButton" prefHeight="40" prefWidth="110.0" style="-fx-font-size: 16; -fx-border-color: #ffffff; -fx-border-width: 2; -fx-background-color: transparent; -fx-text-fill: white;" text="Выход" HBox.hgrow="NEVER" />
                        <Button prefHeight="40" prefWidth="110.0" style="-fx-font-size: 16; -fx-border-color: #ffffff; -fx-border-width: 2; -fx-background-color: transparent; -fx-text-fill: white;" text="Настройки" HBox.hgrow="NEVER" />
                        <Label fx:id="chatTitleLabel" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="40.0" prefWidth="450.0" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-border-width: 2; -fx-border-color: white;" text="Чат с AVKuzma " HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets left="10.0" right="10.0" />
                            </padding>
                        </Label>
                        <Button fx:id="callButton" prefHeight="40" prefWidth="110.0" style="-fx-font-size: 16; -fx-border-color: #ffffff; -fx-border-width: 2; -fx-background-color: transparent; -fx-text-fill: white;" text="Позвонить" HBox.hgrow="NEVER">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>
    <center>
        <HBox spacing="0">
            <children>
                <VBox prefWidth="250" style="-fx-background-color: #34495e; -fx-border-color: #2c3e50; -fx-border-width: 0 2 0 0;">
                    <children>
                        <ListView fx:id="contactsList" prefHeight="401.0" prefWidth="256.0" style="-fx-control-inner-background: #454f97; -fx-text-fill: white;" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
                <VBox spacing="0" HBox.hgrow="ALWAYS">
                    <children>
                        <TextArea fx:id="chatHistory" editable="false" prefHeight="349.0" prefWidth="584.0" style="-fx-control-inner-background: #dadef7; -fx-font-size: 12;" wrapText="true" VBox.vgrow="ALWAYS" />
                        <HBox spacing="5" style="-fx-padding: 10; -fx-background-color: #dadef7;">
                            <children>
                                <TextField fx:id="messageInput" promptText="Введите сообщение..." style="-fx-padding: 8; -fx-font-size: 12;" HBox.hgrow="ALWAYS" />
                                <Button fx:id="sendButton" prefWidth="100" style="-fx-padding: 8; -fx-font-size: 12;" text="Отправить" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
